# CSO Learning Hub environment template.
# Copy to .env for local development, then replace placeholders outside git.
# Do not commit real secrets, production URLs with credentials, or private keys.

# ---------------------------------------------------------------------------
# Supabase Postgres / Prisma
# ---------------------------------------------------------------------------
# Use the Supabase pooled ORM/Prisma connection string for app runtime.
DATABASE_URL="[Supabase pooled Prisma/runtime connection string]"

# Use the Supabase direct connection string for Prisma migrations.
# Do not use the direct migration URL as the normal serverless runtime URL.
DIRECT_URL="[Supabase direct connection string for migrations]"

# ---------------------------------------------------------------------------
# App URL / session
# ---------------------------------------------------------------------------
# Strong secret used by current/legacy Hub session signing during migration.
SESSION_SECRET="[long random production secret]"

# Public Hub URL used by auth redirects, secure cookie behavior, emails, and absolute links.
NEXT_PUBLIC_APP_URL="https://[your-vercel-hub-domain]"

# ---------------------------------------------------------------------------
# Supabase Auth / API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[your-project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="[supabase publishable key]"
# Legacy Supabase projects may use this public key name instead. Configure one
# public key variable, not a real value in Git.
NEXT_PUBLIC_SUPABASE_ANON_KEY="[legacy supabase anon key, if applicable]"

# Server-only Supabase service role key. Only configure this if a server-side
# admin action requires it. Never prefix this with NEXT_PUBLIC, never expose it
# to client/browser code, and never commit a real service role key.
SUPABASE_SECRET_KEY="[server-only service role key, only if needed]"

# ---------------------------------------------------------------------------
# HRBA external course
# ---------------------------------------------------------------------------
# The real pilot HRBA course remains deployed separately and is launched through the Hub.
HRBA_EXTERNAL_COURSE_URL="https://pilot-hrba-e-learn-v1-wajj.vercel.app"
HRBA_EXTERNAL_COURSE_ALLOWED_ORIGINS="https://pilot-hrba-e-learn-v1-wajj.vercel.app"

# ---------------------------------------------------------------------------
# Transitional legacy pilot registration values
# ---------------------------------------------------------------------------
# Open Hub registration does not read these values. Keep placeholders only
# while older Preview configuration is being retired after connected QA.
PILOT_ACCESS_CODE="[private pilot code]"
PILOT_ACCESS_CODES="[optional comma-separated private codes]"
PILOT_REGISTRATION_MODE="[unused transitional value]"
PILOT_INVITED_EMAILS="[unused transitional invited emails]"

# ---------------------------------------------------------------------------
# Optional SMTP
# ---------------------------------------------------------------------------
# These are needed only if the Hub sends emails directly, such as staff
# invitations. Supabase Auth confirmation/reset email settings are configured
# in the Supabase dashboard.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="replace-with-smtp-username"
SMTP_PASS="replace-with-smtp-password"
SMTP_SECURE="false"
EMAIL_FROM="CSO Learning Hub <no-reply@example.com>"
