# Database configuration for local, isolated database.
# NEVER connect to staging (fgyxbzwdvngqlksyxuwa) or production (bhzyrthinbyqgsetnoph) Supabase databases for testing!
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cso_learning_hub_test"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/cso_learning_hub_test"

# Safety opt-in for seeding. 
# Seeding WILL NOT run on staging/production databases, and requires localhost.
ALLOW_DESTRUCTIVE_DEMO_SEED=true
APP_ENVIRONMENT=local-test

# App and session secrets
SESSION_SECRET="your-local-development-session-secret-at-least-32-characters"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
APP_ENV="local-test"
